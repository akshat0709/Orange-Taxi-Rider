{
  "expo": {
    "name": "Orange Taxi",
    "slug": "orange-taxi-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D11",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orangetaxi.rider",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orange Taxi uses your precise location to identify your pickup bay, show electric cabs nearby, calculate upfront fares, and navigate your chauffeur to your exact location.",
        "NSPhotoLibraryUsageDescription": "Orange Taxi allows selecting a profile photo for chauffeur identification at pickup."
      },
      "config": {}
    },
    "android": {
      "package": "com.orangetaxi.rider",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCz4SEloomUEX3wQaFn4avuNvQemjuBkMM"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B0D11",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "6281f240-7855-4c28-b728-82e0ec12a71d"
      }
    },
    "owner": "akshat0709"
  }
}
