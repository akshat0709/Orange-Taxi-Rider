{
  "expo": {
    "name": "Orange Taxi",
    "slug": "orange-taxi-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D11",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orangetaxi.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orange Taxi needs your location to detect your pickup point."
      },
      "config": {
      }
    },
    "android": {
      "package": "com.orangetaxi.rider",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B0D11",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}